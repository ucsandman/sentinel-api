# Sentinel Intelligence API — copy to .env and fill in. Never commit .env.

# --- Card checkout (Stripe) -------------------------------------------------
# Enables GET /buy/{slug} and the Buy buttons on the landing page.
# Without it, the API is agent-only and no human can pay.
STRIPE_SECRET_KEY=sk_test_replace_me

# Absolute public URL of this service. Stripe redirects back here after
# checkout, so it must match the deployed host exactly (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8000

# --- On-demand research (POST /research) ------------------------------------
# Without this, /research returns 503 and takes no payment.
ANTHROPIC_API_KEY=sk-ant-replace_me
RESEARCH_MODEL=claude-haiku-4-5-20251001

# --- x402 settlement (Coinbase CDP) -----------------------------------------
# With a working key pair the facilitator settles on Base mainnet for real.
# Without it the server falls back to a local facilitator that verifies
# signatures but DOES NOT move funds.
CDP_API_KEY_ID=replace_me
CDP_API_KEY_SECRET=replace_me

# Serve paid content while running the local facilitator. Off by default,
# because in that mode no USDC is collected and the product is given away.
# Only set this to true if you intend to settle pending_settlements.jsonl
# on chain yourself.
ALLOW_LOCAL_FACILITATOR=false
